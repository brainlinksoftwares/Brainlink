rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'sales';
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || request.auth.token.email.matches('.*admin@brainlink[.]in.*'));
    }
    
    function isManager() {
      return isAuthenticated() && (getUserRole() == 'manager' || isAdmin());
    }

    // Leads collection
    match /leads/{leadId} {
      // Allow public form /apply to create leads
      allow create: if true;
      // Authenticated users can view leads according to permissions
      allow read: if isAuthenticated();
      // Managers and Admins can update any lead; Sales can update their assigned leads
      allow update: if isAuthenticated() && (
        isManager() || 
        resource.data.assignedTo == request.auth.uid
      );
      // Only Admins can delete or permanently purge leads
      allow delete: if isAdmin();
    }

    // Activities & Audit logs (immutable)
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if true; // Allows system and users to log actions
      allow update, delete: if false; // Immutable audit log!
    }

    // Follow-ups
    match /followups/{followUpId} {
      allow read, write: if isAuthenticated();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // Clients & Projects
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Users and roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CRM Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
